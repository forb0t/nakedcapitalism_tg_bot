# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram ID администраторов через запятую — они могут добавлять и удалять ленты.
# Свой ID можно узнать, отправив боту команду /id
ADMIN_IDS=

# Как часто проверять ленты, в минутах (по умолчанию 60, минимум 5)
# CHECK_INTERVAL_MINUTES=60

# Часовой пояс для времени публикации статей
# BOT_TIMEZONE=Europe/Moscow

# Опционально: прокси для исходящих запросов бота (Telegram + сайты с лентами).
# Пример SOCKS5 через контейнер/хост:
# ALL_PROXY=socks5://user:pass@192.168.1.179:1080
# HTTPS_PROXY=socks5://user:pass@192.168.1.179:1080
# HTTP_PROXY=socks5://user:pass@192.168.1.179:1080
# NO_PROXY=localhost,127.0.0.1,::1
