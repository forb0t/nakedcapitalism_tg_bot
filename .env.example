# Скопируйте в .env и подставьте токен от @BotFather.
# Файл .env в репозиторий не коммитится.

TELEGRAM_BOT_TOKEN=your_bot_token_here

# Опционально: прокси для исходящих запросов бота (Telegram + мониторинг сайта).
# Пример SOCKS5 через контейнер/хост:
# ALL_PROXY=socks5://user:pass@192.168.1.179:1080
# HTTPS_PROXY=socks5://user:pass@192.168.1.179:1080
# HTTP_PROXY=socks5://user:pass@192.168.1.179:1080
# NO_PROXY=localhost,127.0.0.1,::1
